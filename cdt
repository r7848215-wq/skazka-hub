-- 🛠️ ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ КОР-ЛОГИКИ
---------------------------------------------------------------------------------------
local function getVehicleSeat()
    local character = LocalPlayer.Character
    if character and character:FindFirstChild("Humanoid") then
        local seat = character.Humanoid.SeatPart
        if seat and seat:IsA("VehicleSeat") then
            return seat
        end
    end
    return nil
end

-- Функция мгновенного пинка (Буста) вперед
local function executeInstantBoost()
    if not Config.Active then return end
    local seat = getVehicleSeat()
    if seat then
        seat.AssemblyLinearVelocity = seat.CFrame.LookVector * (Config.MaxSpeed * 1.2)
    end
end

